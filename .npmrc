# Tags are unprefixed (e.g. "11.6.0", not "v11.6.0") to match this
# package's existing release history. build.yml names the release tag
# itself; this setting keeps a local `npm version` from adding a "v".
tag-version-prefix=

# Never run dependency or package lifecycle scripts implicitly.
ignore-scripts=true

# Delay newly published dependencies long enough for ecosystem review.
min-release-age=14
